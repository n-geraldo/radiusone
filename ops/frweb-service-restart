#!/usr/bin/env bash
# Root helper behind the Restart buttons on Monitoring → RADIUS server. www-data may run it through
# sudo only with one of the unit names listed in /etc/sudoers.d/freeradius-web-services.
# The restart starts two seconds later in a transient systemd unit, so the web request that asked for
# it (served by nginx and PHP-FPM, talking to MariaDB) can still answer first.
# Installed by ops/apply-service-control.sh as /usr/local/sbin/frweb-service-restart.
set -euo pipefail
PATH=/usr/sbin:/usr/bin:/sbin:/bin

unit=${1:-}
case "$unit" in
  freeradius|mariadb|nginx) ;;
  php[0-9].[0-9]-fpm) [[ -f "/lib/systemd/system/$unit.service" ]] || { echo "Unknown unit: $unit" >&2; exit 2; } ;;
  *) echo "Not a restartable unit: $unit" >&2; exit 2 ;;
esac

# A broken configuration would leave the service down after the restart, so check it first.
case "$unit" in
  freeradius) out=$(freeradius -C 2>&1) || { echo "FreeRADIUS configuration check failed:" >&2; tail -n 5 <<<"$out" >&2; exit 3; } ;;
  nginx) out=$(nginx -t 2>&1) || { echo "Nginx configuration check failed:" >&2; tail -n 5 <<<"$out" >&2; exit 3; } ;;
  php*-fpm) version=${unit#php}; version=${version%-fpm}
            out=$("php-fpm$version" -t 2>&1) || { echo "PHP-FPM configuration check failed:" >&2; tail -n 5 <<<"$out" >&2; exit 3; } ;;
esac

systemd-run --quiet --collect --on-active=2 --unit="frweb-restart-$unit-$(date +%s)" systemctl restart "$unit.service"
echo "Restart of $unit scheduled."
