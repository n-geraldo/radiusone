#!/usr/bin/env bash
# Root helper behind Settings → Overview → Software update. Updates the portal to a newer release tag
# (vX.Y.Z) from its git remote; untagged commits on the branch are never installed.
#   frweb-update check              fetches the release tags and prints JSON (current, latest, notes...)
#   frweb-update schedule vX.Y.Z    what www-data may run through sudo: checks the tag and starts "apply"
#                                   in a transient systemd unit, so the web request can answer first
#   frweb-update apply vX.Y.Z       the update itself (also usable by hand, as root)
# The update: database backup → maintenance mode → fast-forward to the tag → PHP libraries → web pages
# → database migrations and grants → root helpers → portal back up. If a step fails, the code goes back
# to the previous version and the portal comes back up on it.
# Git, Composer and npm run as the owner of the app folder (root after install.sh), so the files keep
# their owner. A private repository needs read access for that user (an SSH deploy key, for example).
# Installed by ops/apply-service-control.sh as /usr/local/sbin/frweb-update. Progress goes to
# /var/log/freeradius-web/update.log, the result to /var/lib/freeradius-web/update-status.json.
set -Eeuo pipefail
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
app=/opt/freeradius-web-laravel
log=/var/log/freeradius-web/update.log
status=/var/lib/freeradius-web/update-status.json
unit=frweb-update.service
TAG_RE='^v[0-9]+\.[0-9]+\.[0-9]+$'

mode=${1:-}
tag=${2:-}
owner=$(stat -c %U "$app")
# Composer may be installed for that user only (~/.local/bin) rather than system-wide.
owner_path="$(getent passwd "$owner" | cut -d: -f6)/.local/bin:$PATH"
as_owner() {
  if [[ $owner == root ]]; then env PATH="$owner_path" COMPOSER_ALLOW_SUPERUSER=1 LOG_CHANNEL=stderr "$@"
  else sudo -u "$owner" -H env PATH="$owner_path" LOG_CHANNEL=stderr "$@"; fi
}
git_() { as_owner git -C "$app" "$@"; }
current() { tr -d '[:space:]' < "$app/VERSION" 2>/dev/null || echo 0.0.0; }
# 0 when version $1 is newer than $2.
newer() { [[ "$1" != "$2" && "$(printf '%s\n%s\n' "$1" "$2" | sort -V | tail -n 1)" == "$1" ]]; }
json() {  # key=value pairs → one JSON object (values from the environment, encoded by PHP)
  local args=() pair
  for pair in "$@"; do args+=("${pair%%=*}"); export "J_${pair%%=*}=${pair#*=}"; done
  php -r '$o = []; foreach (array_slice($argv, 1) as $k) { $o[$k] = getenv("J_" . $k); } echo json_encode($o, JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE), "\n";' -- "${args[@]}"
}
write_status() {  # state step message
  mkdir -p "$(dirname "$status")"
  json state="$1" step="$2" message="$3" from="${from:-}" to="${tag#v}" at="$(date '+%F %T %Z')" > "$status.tmp"
  chmod 0644 "$status.tmp" && mv -f "$status.tmp" "$status"
}

[[ -d "$app/.git" ]] || { echo "Not a git checkout: $app" >&2; exit 2; }

case "$mode" in
  check)
    out=''
    if ! out=$(git_ fetch --quiet --tags --force origin 2>&1); then
      json ok=0 current="$(current)" error="Could not reach the update server: ${out:0:300}"
      exit 0
    fi
    latest=$(git_ tag -l 'v[0-9]*.[0-9]*.[0-9]*' | grep -E "$TAG_RE" | sort -V | tail -n 1 || true)
    cur=$(current)
    if [[ -z "$latest" ]] || ! newer "${latest#v}" "$cur"; then
      json ok=1 current="$cur" latest="${latest#v}" newer=0
      exit 0
    fi
    # What changed since this version: the changelog sections above the current one.
    notes=$(git_ show "$latest:CHANGELOG.md" 2>/dev/null | awk -v cur="## $cur " '/^## /{ if (index($0, cur) == 1) exit; on=1 } on' | head -n 80 || true)
    problem=''
    git_ merge-base --is-ancestor HEAD "$latest" || problem='This server has changes that are not in the release, so it cannot update automatically.'
    [[ -z "$(git_ status --porcelain --untracked-files=no)" ]] || problem='Files in the app folder were changed by hand, so it cannot update automatically.'
    json ok=1 current="$cur" latest="${latest#v}" newer=1 tag="$latest" notes="$notes" problem="$problem"
    exit 0 ;;
  schedule|apply)
    [[ "$tag" =~ $TAG_RE ]] || { echo "Not a release tag: $tag" >&2; exit 2; }
    git_ rev-parse -q --verify "refs/tags/$tag" >/dev/null || { echo "Unknown release $tag: check for updates first." >&2; exit 2; } ;;
  *) echo "Usage: $0 check | schedule vX.Y.Z | apply vX.Y.Z" >&2; exit 2 ;;
esac

if [[ $mode == schedule ]]; then
  if systemctl is-active --quiet "$unit"; then echo 'An update is already running.' >&2; exit 3; fi
  newer "${tag#v}" "$(current)" || { echo "$tag is not newer than the installed $(current)." >&2; exit 2; }
  systemctl reset-failed "$unit" 2>/dev/null || true
  from=$(current) write_status running scheduled "Update to ${tag#v} is starting."
  systemd-run --quiet --collect --unit="${unit%.service}" /usr/local/sbin/frweb-update apply "$tag"
  echo "Update to $tag started."
  exit 0
fi

# --- apply -------------------------------------------------------------------------------------------
mkdir -p "$(dirname "$log")"
exec > >(tee -a "$log") 2>&1
from=$(current)
old=$(git_ rev-parse HEAD)
step=start
migrated=0
cd "$app"
echo "$(date '+%F %T %Z') update $from → ${tag#v} started"

# The servers set up by install.sh run without development packages.
composer_flags=(--no-interaction --no-progress --optimize-autoloader)
[[ -f /etc/freeradius-web/.installed-by-install-sh ]] && composer_flags+=(--no-dev)
dependencies() {
  as_owner composer install "${composer_flags[@]}" -d "$app"
  as_owner npm --prefix "$app" ci --no-audit --no-fund --loglevel=error
  as_owner npm --prefix "$app" run build --silent >/dev/null
}

rollback() {
  trap - ERR
  echo "== failed during: $step"
  if [[ "$(git_ rev-parse HEAD)" != "$old" ]]; then
    echo "== going back to $from"
    git_ reset --hard --quiet "$old" && dependencies || echo 'Rolling back the code failed too: see the lines above.'
  fi
  LOG_CHANNEL=stderr php artisan up >/dev/null 2>&1 || true
  local note=''
  [[ $migrated == 1 ]] && note=' The database migrations had already run; the backup taken before the update is in the backups folder.'
  write_status failed "$step" "The update stopped at: $step. The portal runs $from again.$note See the log for details."
  echo "$(date '+%F %T %Z') failed; back on $from"
  exit 1
}
trap rollback ERR

step='checking the release'
write_status running "$step" "Checking ${tag}."
[[ -z "$(git_ status --porcelain --untracked-files=no)" ]] || { echo 'Files in the app folder were changed by hand; not updating.'; false; }
git_ merge-base --is-ancestor HEAD "$tag" || { echo "$tag does not follow the installed version; not updating."; false; }
as_owner sh -c 'command -v composer && command -v npm' >/dev/null || { echo "Composer or npm is not available to $owner; not updating."; false; }

step='backing up the database'
write_status running "$step" 'Backing up the database.'
if [[ -f /etc/freeradius-web/backup.env ]]; then
  FRWEB_OPERATOR_ENV_FILE=/etc/freeradius-web/backup.env LOG_CHANNEL=stderr php artisan frweb:backup --no-upload
else
  echo 'No backup identity (/etc/freeradius-web/backup.env); skipping the backup.'
fi

step='starting maintenance mode'
sleep 2   # let the web request that started the update answer first
LOG_CHANNEL=stderr php artisan down --retry=20

step='downloading the new version'
write_status running "$step" "Installing ${tag#v}."
git_ merge --ff-only --quiet "$tag"

step='installing libraries and building the pages'
write_status running "$step" 'Installing libraries and building the pages.'
dependencies

step='updating the database'
write_status running "$step" 'Updating the database.'
migrated=1
FRWEB_OPERATOR_ENV_FILE=/etc/freeradius-web/migration.env LOG_CHANNEL=stderr php artisan frweb:migrate
[[ -f ops/install/grants.sql ]] && mariadb < ops/install/grants.sql

step='updating the server helpers'
bash ops/apply-service-control.sh >/dev/null
[[ $owner == root ]] && chown -R www-data:www-data storage bootstrap/cache
systemctl reload 'php*-fpm.service' 2>/dev/null || true

step='leaving maintenance mode'
LOG_CHANNEL=stderr php artisan up
trap - ERR
write_status ok done "Updated from $from to ${tag#v}."
echo "$(date '+%F %T %Z') done: $from → ${tag#v}"
