#!/usr/bin/env bash
# Root helper behind Settings → Backups → Back up now. Starts the same backup as the nightly cron line
# (radiusone:backup with the read-only backup identity) in a transient systemd unit, so the web request
# answers at once; the page shows "running" while radiusone-backup-now.service is active, then the result
# from status.json. radiusone:backup itself refuses to run twice at the same time.
# Installed by ops/radiusone-postinstall as /usr/local/sbin/radiusone-backup-now.
set -euo pipefail
PATH=/usr/sbin:/usr/bin:/sbin:/bin

if systemctl is-active --quiet radiusone-backup-now.service; then
  echo 'A backup is already running.' >&2
  exit 3
fi
systemctl reset-failed radiusone-backup-now.service 2>/dev/null || true
# LOG_CHANNEL=stderr: a root process must not create Laravel log files that www-data then cannot write.
# radiusone-root-artisan: root must not load the cache files www-data can write in bootstrap/cache.
systemd-run --quiet --collect --unit=radiusone-backup-now --working-directory=/opt/radiusone \
  --setenv=RADIUSONE_OPERATOR_ENV_FILE=/etc/radiusone/backup.env --setenv=LOG_CHANNEL=stderr \
  /bin/sh -c '/usr/local/sbin/radiusone-root-artisan radiusone:backup >/var/log/radiusone/backup.log 2>&1'
echo 'Backup started.'
